<%= form_with(model: trimester) do |form| %>
  <% if trimester.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(trimester.errors.count, "error") %> prohibited this trimester from being saved:</h2>

      <ul>
        <% trimester.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  
  <div>
    <%= form.label :trimester_id, style: "display: block" %>
    <%= form.text_field :display_name, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :start_date, 'Start Date', class: 'form-text' %>
    <%= form.text_field :start_date, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :end_date, 'End Date', class: 'form-text' %>
    <%= form.text_field :end_date, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :application_deadline, 'Application Deadline', class: 'form-text' %>
    <%= form.text_field :application_deadline, class: 'form-control' %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
